// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Test {
  id  Int @id @default(autoincrement())
  name  String
  isCompleted Boolean @default(false)
}

model EmakiMetaData{
  id  Int @id @default(autoincrement())
  title  String
  titleen String
  thumb String?
  desc String?
  kotobagaki Boolean @default(false)
  keyword Keyword[] @relation("EmakiMetaDataToKeyword")
}

model Keyword {
  id Int @id @default(autoincrement())
  name String
  nameen String
  emakimetadata EmakiMetaData[] @relation("EmakiMetaDataToKeyword")
}