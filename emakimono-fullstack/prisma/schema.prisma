// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EmakiMetaData{
id    String  @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  title  String
  titleen String @unique
  thumb String?
  desc String?
  kotobagaki Boolean @default(false)
  keyword Keyword[] @relation("EmakiMetaDataToKeyword")
  type Type[] @relation("EmakiMetaDataToType")
}

model Keyword {
id    String  @id @default(dbgenerated("uuid_generate_v4()"))
  name String
  nameen String @unique
  emakimetadata EmakiMetaData[] @relation("EmakiMetaDataToKeyword")
}

model Type {
id    String  @id @default(dbgenerated("uuid_generate_v4()"))
  name String
  nameen String @unique
  emakimetadata EmakiMetaData[] @relation("EmakiMetaDataToType")
}