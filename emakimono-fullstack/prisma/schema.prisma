// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Test {
  id  Int @id @default(autoincrement())
  name  String
  isCompleted Boolean @default(false)
}

model EmakiMetaData{
  id   String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  title  String
  titleen String @unique
  thumb String?
  desc String?
  kotobagaki Boolean @default(false)
  keyword Keyword[] @relation("EmakiMetaDataToKeyword")
  type Type[] @relation("EmakiMetaDataToType")
}

model Keyword {
  id   String @id @default(uuid())
  name String
  nameen String @unique
  emakimetadata EmakiMetaData[] @relation("EmakiMetaDataToKeyword")
}

model Type {
  id   String @id @default(uuid())
  name String
  nameen String @unique
  emakimetadata EmakiMetaData[] @relation("EmakiMetaDataToType")
}